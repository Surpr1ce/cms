{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "PowerShell"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(shred:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Bash(chmod -R:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(git branch -D:*)",
      "Bash(php bin/console doctrine:database:drop:*)",
      "Bash(php bin/console doctrine:schema:drop:*)",
      "Bash(php bin/console doctrine:schema:update:*)",
      "Bash(php bin/console doctrine:migrations:rollup:*)",
      "Bash(dropdb:*)",
      "Bash(psql:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(Clear-Content:*)",
      "PowerShell(Format-Volume:*)",
      "PowerShell(Stop-Computer:*)",
      "PowerShell(Stop-Service:*)",
      "PowerShell(Set-ExecutionPolicy:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git filter-branch:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(php bin/console doctrine:database:drop:*)",
      "PowerShell(php bin/console doctrine:schema:drop:*)",
      "PowerShell(php bin/console doctrine:schema:update:*)",
      "PowerShell(php bin/console doctrine:migrations:rollup:*)",
      "PowerShell(dropdb:*)",
      "PowerShell(psql:*)"
    ]
  }
}