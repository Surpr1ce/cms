{#
   One article in a listing. Title, date, author, and the summary if there is one.

   The summary is optional in the model, so the markup collapses rather than
   leaving a gap — spec US1 scenario 4.
#}
<article class="border-b border-rule pb-8 last:border-0">
    <h2 class="text-xl font-semibold tracking-tight">
        <a href="{{ path('article_show', { slug: article.slug }) }}" class="text-ink no-underline hover:underline">
            {{ article.title }}
        </a>
    </h2>

    <p class="mt-1 text-sm text-muted">
        {% if article.publishedAt %}
            <time datetime="{{ article.publishedAt|date('Y-m-d') }}">{{ article.publishedAt|date('j F Y') }}</time>
            <span aria-hidden="true">·</span>
        {% endif %}
        {{ article.author.displayName }}
        {% if article.category %}
            <span aria-hidden="true">·</span>
            <a href="{{ path('category_show', { slug: article.category.slug }) }}" class="text-muted hover:text-ink">
                {{ article.category.name }}
            </a>
        {% endif %}
    </p>

    {% if article.excerpt %}
        <p class="mt-3 text-ink/80">{{ article.excerpt }}</p>
    {% endif %}
</article>
