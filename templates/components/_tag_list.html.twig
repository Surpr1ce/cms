{% if tags is not empty %}
    <ul class="mt-6 flex flex-wrap gap-2 border-t border-rule pt-6 text-sm">
        {% for tag in tags %}
            <li>
                <a href="{{ path('tag_show', { slug: tag.slug }) }}"
                   class="rounded-full border border-rule px-3 py-1 text-muted no-underline hover:border-accent hover:text-accent">
                    {{ tag.name }}
                </a>
            </li>
        {% endfor %}
    </ul>
{% endif %}
