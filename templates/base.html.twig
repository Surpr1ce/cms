<!DOCTYPE html>
<html lang="en" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ site_name }}{% endblock %}</title>
        {% block meta %}
            <meta name="description" content="{% block meta_description %}{% endblock %}">
        {% endblock %}
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.05em%22 font-size=%22104%22>&#9679;</text></svg>">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {#
               The nonce marks the three inline scripts importmap() emits — the
               map itself, the polyfill loader and the entry import — as ours.
               Without it the content security policy set by
               SecurityHeadersSubscriber refuses all three and the site loads no
               JavaScript at all.
            #}
            {% block importmap %}{{ importmap('app', { nonce: csp_nonce('script') }) }}{% endblock %}
        {% endblock %}
    </head>
    <body class="h-full bg-white text-ink antialiased">
        {% block body %}{% endblock %}
    </body>
</html>
