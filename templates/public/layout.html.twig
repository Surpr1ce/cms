{% extends 'base.html.twig' %}

{#
   The site's own chrome. Every public page and every error page extends this,
   which is what makes a 404 look like it belongs to the site rather than to the
   framework.
#}

{% block body %}
    {#
       A skip link, first in the document and visible only when focused.
       Somebody using a keyboard would otherwise tab through the whole header —
       menu, sections, search — on every page before reaching what they came for.
    #}
    <a href="#main"
       class="sr-only rounded bg-ink px-4 py-2 text-white focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50">
        Skip to the content
    </a>

    <div class="flex min-h-full flex-col">
        {#
           One bar: the site's name on the left, where it goes; the navigation in
           the middle; the search on the right.

           The order in the markup is the order somebody reading with a keyboard
           or a screen reader meets it, and it is also the order it appears in
           when the bar has to stack. `order-*` only rearranges the visual line
           once there is room for one — below that the three sit above each
           other, which is the only arrangement that fits a narrow screen without
           squeezing the search into something nobody can type in.
        #}
        {% set sections = public_sections() %}
        {% set menu = public_menu() %}

        <header class="border-b border-rule">
            <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-3 px-5 py-4">
                <a href="{{ path('home') }}"
                   class="shrink-0 text-lg font-semibold tracking-tight text-ink no-underline">
                    {{ site_name }}
                </a>

                {% if sections is not empty or menu is not empty %}
                    <nav class="order-last flex w-full flex-wrap items-baseline gap-x-5 gap-y-1 text-sm sm:order-none sm:w-auto sm:flex-1 sm:justify-center"
                         aria-label="Site">
                        {{ include(
                            'components/_sections_menu.html.twig',
                            { sections: sections },
                            with_context = false
                        ) }}

                        {% if sections is not empty and menu is not empty %}
                            <span class="text-rule" aria-hidden="true">|</span>
                        {% endif %}

                        {{ include('components/_menu.html.twig', { pages: menu }, with_context = false) }}
                    </nav>
                {% endif %}

                {#
                   Overridable, and the search screen overrides it away: that page
                   carries its own search box, and two of them on one screen is a
                   question about which one to type into.
                #}
                {% block header_search %}
                    <div class="ml-auto w-full sm:w-64">
                        {{ include(
                            'components/_search_form.html.twig',
                            { query: app.request.query.get('q'), autofocus: false },
                            with_context = false
                        ) }}
                    </div>
                {% endblock %}
            </div>
        </header>

        <main id="main" class="mx-auto w-full max-w-5xl grow px-5 py-10">
            {#
               Listings use the whole width; prose does not. A line of text a
               thousand pixels wide is measurably harder to read — the eye loses
               its place returning to the start of the next one — so the article
               and page screens narrow this to a reading measure and everything
               else keeps the room.
            #}
            <div class="mx-auto w-full {% block reading_width %}max-w-5xl{% endblock %}">
                {% block breadcrumbs %}{% endblock %}
                {% block main %}{% endblock %}
            </div>
        </main>

        {#
           No top margin. `main` is `grow` inside a `min-h-full` column, which is
           already what holds the footer at the bottom — a margin on top of that
           makes the page taller than the viewport, so a short page scrolls to
           reveal a band of nothing above the footer. The room comes from the
           footer's own padding instead, which does not add to the height of a
           page that is already tall enough.
        #}
        <footer class="border-t border-rule">
            <div class="mx-auto max-w-5xl px-5 py-12">
                <div class="grid gap-8 sm:grid-cols-3">
                    <div>
                        <p class="text-sm font-semibold text-ink">{{ site_name }}</p>
                        <ul class="mt-2 space-y-1 text-sm">
                            <li>
                                <a href="{{ path('feed') }}"
                                   class="text-muted no-underline hover:text-ink hover:underline">
                                    Subscribe by feed
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('search') }}"
                                   class="text-muted no-underline hover:text-ink hover:underline">
                                    Search
                                </a>
                            </li>
                        </ul>
                    </div>

                    {% if sections is not empty %}
                        <div>
                            <p class="text-sm font-semibold text-ink">Sections</p>
                            <ul class="mt-2 space-y-1 text-sm">
                                {% for section in sections %}
                                    <li>
                                        <a href="{{ path('category_show', { slug: section.slug }) }}"
                                           class="text-muted no-underline hover:text-ink hover:underline">
                                            {{ section.name }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    {% if menu is not empty %}
                        <div>
                            <p class="text-sm font-semibold text-ink">Pages</p>
                            <ul class="mt-2 space-y-1 text-sm">
                                {% for entry in menu %}
                                    <li>
                                        <a href="{{ path('page_show', { slug: entry.page.slug }) }}"
                                           class="text-muted no-underline hover:text-ink hover:underline">
                                            {{ entry.page.title }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                </div>

                {#
                   The sign-in link lives here rather than in the header: a
                   reader has no use for it, and an editor knows where it is.
                   Present at all because a site whose administration has no
                   visible way in is a site people ask about.
                #}
                <p class="mt-8 border-t border-rule pt-6 text-xs text-muted">
                    <a href="{{ path('login') }}" class="text-muted no-underline hover:text-ink hover:underline">
                        Sign in
                    </a>
                </p>
            </div>
        </footer>
    </div>
{% endblock %}
