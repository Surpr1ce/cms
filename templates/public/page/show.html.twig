{% extends 'public/layout.html.twig' %}

{% block title %}{{ page_content.title }} — {{ site_name }}{% endblock %}
{% block meta_description %}{{ (page_content.excerpt ?: page_content.content)|summarise }}{% endblock %}

{% block preview_image %}
    {%- if page_content.featuredImage -%}
        {{ url('media_sized', { size: 'large', filename: page_content.featuredImage.filename }) }}
    {%- endif -%}
{% endblock %}

{% block preview_type %}article{% endblock %}

{% block main %}
    <article>
        {#
           Where in the structure the reader is — US4 scenario 5. Only ancestors
           that are themselves published appear, so the trail cannot disclose a
           draft parent's title.
        #}
        {% if ancestors is not empty %}
            <nav class="text-sm text-muted" aria-label="Breadcrumb">
                {% for ancestor in ancestors %}
                    <a href="{{ path('page_show', { slug: ancestor.slug }) }}"
                       class="text-muted no-underline hover:text-ink hover:underline">{{ ancestor.title }}</a>
                    <span aria-hidden="true">/</span>
                {% endfor %}
                <span>{{ page_content.title }}</span>
            </nav>
        {% endif %}

        <h1 class="mt-2 text-3xl font-semibold tracking-tight">{{ page_content.title }}</h1>

        {% if page_content.featuredImage %}
            <img src="{{ path('media_sized', { size: 'large', filename: page_content.featuredImage.filename }) }}"
                 alt="{{ page_content.featuredImage.altText }}"
                 class="mt-8 w-full rounded-lg"
                 loading="lazy"
                 data-hide-on-error>
        {% endif %}

        {# No author and no date: a page has neither. FR-010. #}
        <div class="prose mt-8">
            {{ page_content.content|raw }}
        </div>

        {% if children is not empty %}
            <ul class="mt-10 flex flex-wrap gap-x-4 gap-y-1 border-t border-rule pt-6 text-sm">
                {% for child in children %}
                    <li>
                        <a href="{{ path('page_show', { slug: child.slug }) }}"
                           class="text-accent no-underline hover:underline">{{ child.title }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </article>
{% endblock %}
