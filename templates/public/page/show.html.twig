{% extends 'public/layout.html.twig' %}

{% block title %}{{ page_content.title }} — {{ site_name }}{% endblock %}
{% block meta_description %}{{ (page_content.excerpt ?: page_content.content)|summarise }}{% endblock %}

{% block preview_image %}
    {%- if page_content.featuredImage -%}
        {{ url('media_sized', { size: 'large', filename: page_content.featuredImage.filename }) }}
    {%- endif -%}
{% endblock %}

{% block preview_type %}article{% endblock %}

{# A reading measure: prose, not a listing. #}
{% block reading_width %}max-w-3xl{% endblock %}

{% block breadcrumbs %}
    {#
       Built from `ancestors`, not from `page_content.parent`.

       The controller supplies only ancestors that are themselves published, so
       the trail cannot name a draft parent — which a chain of `.parent` reads
       would do, and which is the disclosure feature 002 exists to prevent. The
       shared component only draws what it is given.
    #}
    {% set trail = [] %}
    {% for ancestor in ancestors %}
        {% set trail = trail|merge([{
            label: ancestor.title,
            path: path('page_show', { slug: ancestor.slug }),
        }]) %}
    {% endfor %}
    {% set trail = trail|merge([{ label: page_content.title }]) %}

    {{ include('components/_breadcrumbs.html.twig', { trail: trail }, with_context = false) }}
{% endblock %}

{% block main %}
    <article>
        <h1 class="text-3xl font-semibold tracking-tight">{{ page_content.title }}</h1>

        {% if page_content.featuredImage %}
            <img src="{{ path('media_sized', { size: 'large', filename: page_content.featuredImage.filename }) }}"
                 alt="{{ page_content.featuredImage.altText }}"
                 class="mt-8 w-full rounded-lg"
                 loading="lazy"
                 data-hide-on-error>
        {% endif %}

        {# No author and no date: a page has neither. FR-010. #}
        <div class="prose mt-8">
            {{ page_content.content|raw }}
        </div>

        {% if children is not empty %}
            <ul class="mt-10 flex flex-wrap gap-x-4 gap-y-1 border-t border-rule pt-6 text-sm">
                {% for child in children %}
                    <li>
                        <a href="{{ path('page_show', { slug: child.slug }) }}"
                           class="text-accent no-underline hover:underline">{{ child.title }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </article>
{% endblock %}
