{% extends 'public/layout.html.twig' %}

{% block title %}{{ tag.name }} — {{ site_name }}{% endblock %}
{% block meta_description %}Articles on {{ site_name }} tagged “{{ tag.name }}”.{% endblock %}

{% block breadcrumbs %}
    {{ include(
        'components/_breadcrumbs.html.twig',
        { trail: [{ label: 'Tagged “' ~ tag.name ~ '”' }] },
        with_context = false
    ) }}
{% endblock %}

{% block main %}
    {{ include('components/_listing_header.html.twig', {
        eyebrow: 'Tagged',
        title: tag.name,
    }, with_context = false) }}

    {% if page.items is empty %}
        <p class="mt-8 text-muted">Nothing published carries this tag yet.</p>
    {% else %}
        <div class="mt-8 space-y-8">
            {% for article in page.items %}
                {{ include('components/_article_card.html.twig', { article: article }, with_context = false) }}
            {% endfor %}
        </div>

        {{ include('components/_pagination.html.twig', {
            page: page,
            route: 'tag_show',
            routeParams: { slug: tag.slug },
        }, with_context = false) }}
    {% endif %}
{% endblock %}
