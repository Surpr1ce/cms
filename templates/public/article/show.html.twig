{% extends 'public/layout.html.twig' %}

{% block title %}{{ article.title }} — {{ site_name }}{% endblock %}
{#
   The excerpt when the author wrote one, the body when they did not. Through
   `summarise` either way: an excerpt can carry markup too, and a description
   containing a tag or a newline is a broken attribute.
#}
{% block meta_description %}{{ (article.excerpt ?: article.content)|summarise }}{% endblock %}

{# Absolute, because whatever renders a preview is not this site. Omitted
   entirely when there is no lead image, rather than pointing at nothing. #}
{% block preview_image %}
    {%- if article.featuredImage -%}
        {{ url('media_sized', { size: 'large', filename: article.featuredImage.filename }) }}
    {%- endif -%}
{% endblock %}

{% block preview_type %}article{% endblock %}

{% block breadcrumbs %}
    {% set trail = [] %}
    {% if article.category %}
        {% set trail = trail|merge([{
            label: article.category.name,
            path: path('category_show', { slug: article.category.slug }),
        }]) %}
    {% endif %}
    {% set trail = trail|merge([{ label: article.title }]) %}

    {{ include('components/_breadcrumbs.html.twig', { trail: trail }, with_context = false) }}
{% endblock %}

{% block main %}
    <article>
        <h1 class="text-3xl font-semibold tracking-tight">{{ article.title }}</h1>

        <p class="mt-2 text-sm text-muted">
            {% if article.publishedAt %}
                <time datetime="{{ article.publishedAt|date('Y-m-d') }}">{{ article.publishedAt|date('j F Y') }}</time>
                <span aria-hidden="true">·</span>
            {% endif %}
            {{ article.author.displayName }}
            <span aria-hidden="true">·</span>
            {{ article.content|reading_time }} min read
            {% if article.category %}
                <span aria-hidden="true">·</span>
                <a href="{{ path('category_show', { slug: article.category.slug }) }}" class="text-muted hover:text-ink">
                    {{ article.category.name }}
                </a>
            {% endif %}
        </p>

        {#
           The lead image, served through the application from outside the web
           root, at the size this column shows it rather than the size it was
           uploaded.

           `data-hide-on-error` hides it instead of leaving a broken-image icon:
           feature 002's FR-023 says a missing file must not stop the article
           rendering, and a record can outlive its bytes. It was an `onerror`
           attribute until feature 012 — which feature 008's content security
           policy had silently been refusing to run since the day it shipped.
        #}
        {% if article.featuredImage %}
            <img src="{{ path('media_sized', { size: 'large', filename: article.featuredImage.filename }) }}"
                 alt="{{ article.featuredImage.altText }}"
                 class="mt-8 w-full rounded-lg"
                 loading="lazy"
                 data-hide-on-error>
        {% endif %}

        <div class="prose mt-8">
            {{ article.content|raw }}
        </div>

        {{ include('components/_tag_list.html.twig', { tags: article.tags }, with_context = false) }}
    </article>

    {{ include('components/_read_next.html.twig', {
        related: related,
        previous: previous,
        next: next,
    }, with_context = false) }}
{% endblock %}
