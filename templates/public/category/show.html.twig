{% extends 'public/layout.html.twig' %}

{% block title %}{{ category.name }} — {{ site_name }}{% endblock %}
{% block meta_description %}{{ category.description|summarise ?: 'Articles in ' ~ category.name ~ ' on ' ~ site_name ~ '.' }}{% endblock %}

{% block breadcrumbs %}
    {% set trail = [] %}
    {% if category.parent %}
        {% set trail = trail|merge([{
            label: category.parent.name,
            path: path('category_show', { slug: category.parent.slug }),
        }]) %}
    {% endif %}
    {% set trail = trail|merge([{ label: category.name }]) %}

    {{ include('components/_breadcrumbs.html.twig', { trail: trail }, with_context = false) }}
{% endblock %}

{% block main %}
    {% set subsections = [] %}
    {% for child in children %}
        {% set subsections = subsections|merge([{
            label: child.name,
            path: path('category_show', { slug: child.slug }),
        }]) %}
    {% endfor %}

    {{ include('components/_listing_header.html.twig', {
        eyebrow: 'Section',
        title: category.name,
        lead: category.description,
        links: subsections,
    }, with_context = false) }}

    {% if page.items is empty %}
        {#
           Empty, not missing. The section exists; it simply has nothing a reader
           may see. Returning 404 here would tell an outsider the difference
           between "no such section" and "a section with only drafts in it".
        #}
        <p class="mt-8 text-muted">Nothing has been published in this section yet.</p>
    {% else %}
        <div class="mt-8 space-y-8">
            {% for article in page.items %}
                {{ include('components/_article_card.html.twig', { article: article }, with_context = false) }}
            {% endfor %}
        </div>

        {{ include('components/_pagination.html.twig', {
            page: page,
            route: 'category_show',
            routeParams: { slug: category.slug },
        }, with_context = false) }}
    {% endif %}
{% endblock %}
