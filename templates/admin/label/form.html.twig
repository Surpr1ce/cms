{% extends 'admin/layout.html.twig' %}

{% block title %}{{ label ? 'Edit label' : 'New label' }} — {{ site_name }}{% endblock %}

{% block main %}
    <p class="text-sm text-muted">
        <a href="{{ path('admin_label_index') }}" class="text-muted no-underline hover:underline">Labels</a>
    </p>

    <h1 class="mt-1 text-2xl font-semibold tracking-tight">
        {{ label ? 'Edit label' : 'New label' }}
    </h1>

    {{ form_start(form) }}
        <div class="mt-8 max-w-xl space-y-5">
            {{ form_row(form.name) }}

            <button type="submit" class="rounded bg-ink px-4 py-2 text-white hover:bg-accent">
                {{ label ? 'Save' : 'Create' }}
            </button>
        </div>
    {{ form_end(form) }}

    {% if label %}
        <div class="mt-10 max-w-xl rounded border border-red-200 p-4">
            <h2 class="text-sm font-semibold text-red-800">Delete</h2>

            <p class="mt-1 text-sm text-muted">
                The articles carrying this label are untouched; they simply stop carrying it.
            </p>

            <form method="post"
                  action="{{ path('admin_label_delete', { id: label.id }) }}"
                  class="mt-3"
                  data-confirm="Delete this label?">
                <input type="hidden" name="_token" value="{{ csrf_token('label-delete-' ~ label.id) }}">
                <button type="submit"
                        class="rounded border border-red-300 px-3 py-1.5 text-sm text-red-800 hover:bg-red-50">
                    Delete this label
                </button>
            </form>
        </div>

        <p class="mt-6 text-xs text-muted">Address: <code>/topics/{{ label.slug }}</code></p>
    {% endif %}
{% endblock %}
