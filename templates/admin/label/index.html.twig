{% extends 'admin/layout.html.twig' %}

{% block title %}Labels — {{ site_name }}{% endblock %}

{% block main %}
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <p class="text-sm text-muted">
                <a href="{{ path('admin_manage') }}" class="text-muted no-underline hover:underline">Manage</a>
            </p>
            <h1 class="mt-1 text-2xl font-semibold tracking-tight">Labels</h1>
        </div>

        <a href="{{ path('admin_label_new') }}"
           class="rounded bg-ink px-4 py-2 text-sm text-white no-underline hover:bg-accent">
            New label
        </a>
    </div>

    <p class="mt-2 max-w-prose text-muted">
        A label answers “what is this about”. An article can carry as many as it needs.
    </p>

    {% if labels is empty %}
        <p class="mt-8 text-muted">Nothing here yet.</p>
    {% else %}
        <div class="mt-6 overflow-x-auto">
            <table class="w-full border-collapse text-sm">
                <thead>
                    <tr class="border-b border-rule text-left">
                        <th class="py-2 pr-4 font-semibold">Name</th>
                        <th class="py-2 pr-4 font-semibold">Address</th>
                        <th class="py-2 font-semibold"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for label in labels %}
                        <tr class="border-b border-rule/60">
                            <td class="py-2 pr-4">
                                <a href="{{ path('admin_label_edit', { id: label.id }) }}"
                                   class="font-medium text-ink no-underline hover:underline">{{ label.name }}</a>
                            </td>
                            <td class="py-2 pr-4">
                                <a href="{{ path('tag_show', { slug: label.slug }) }}"
                                   class="text-muted no-underline hover:underline">
                                    <code>/topics/{{ label.slug }}</code>
                                </a>
                            </td>
                            <td class="py-2 text-right">
                                <a href="{{ path('admin_label_edit', { id: label.id }) }}"
                                   class="text-sm text-accent no-underline hover:underline">Edit</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
