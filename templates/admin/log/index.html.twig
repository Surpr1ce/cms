{% extends 'admin/layout.html.twig' %}

{% block title %}What happened — {{ site_name }}{% endblock %}

{% block main %}
    <h1 class="text-2xl font-semibold tracking-tight">What happened</h1>

    <p class="mt-3 max-w-prose text-muted">
        Publishing, removing and granting — the decisions that change what a reader can see or what
        somebody is allowed to do. Editing an article is not here; a log of every save is a log
        nobody reads.
    </p>

    {% if page.items is empty %}
        <p class="mt-8 text-muted">Nothing has been recorded yet.</p>
    {% else %}
        <table class="mt-8 w-full border-collapse text-sm">
            <thead>
                <tr class="border-b border-rule text-left">
                    <th scope="col" class="py-2 pr-4 font-medium">When</th>
                    <th scope="col" class="py-2 pr-4 font-medium">Who</th>
                    <th scope="col" class="py-2 font-medium">What</th>
                </tr>
            </thead>

            <tbody>
                {% for entry in page.items %}
                    <tr class="border-b border-rule align-top">
                        <td class="py-2 pr-4 whitespace-nowrap text-muted">
                            <time datetime="{{ entry.occurredAt|date('c') }}">
                                {{ entry.occurredAt|date('j M Y, H:i') }}
                            </time>
                        </td>

                        {#
                           The recorded label, not `entry.actor.email`. The
                           relation is severed when an account is deleted, and
                           reading through it would make every entry belonging to
                           somebody who has left go blank — which is exactly the
                           history a reader is most likely to be looking for.
                        #}
                        <td class="py-2 pr-4">{{ entry.actorLabel }}</td>

                        <td class="py-2">
                            {{ entry.action.label }}
                            <span class="text-muted">“{{ entry.subject }}”</span>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {{ include(
            'components/_pagination.html.twig',
            { page: page, route: 'admin_audit_log', routeParams: {} },
            with_context = false
        ) }}
    {% endif %}
{% endblock %}
