{% extends 'admin/layout.html.twig' %}

{% block main %}
    <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h1 class="text-2xl font-semibold tracking-tight">
            {{ article ? 'Edit article' : 'New article' }}
        </h1>

        {% if article %}
            <span class="rounded-full border border-rule px-3 py-1 text-xs text-muted">
                {{ article.status.label }}
            </span>
        {% endif %}
    </div>

    {#
       The whole two-column layout sits inside form_start/form_end, and
       form_end renders what is left — which includes the CSRF token.

       The first version of this template put the sidebar fields outside the
       <form> element and closed with `form_end(form, { render_rest: false })`.
       Both are wrong and both are silent: the sidebar fields were never
       submitted, and the token was never rendered, so every submission came
       back 422 with no message a person could see. The test that stores an
       article is what found it.

       Publication and deletion are separate forms and must stay *after*
       form_end — a form nested in a form is not valid HTML and browsers do
       unpredictable things with it.
    #}
    {{ form_start(form) }}
        <div class="mt-8 grid gap-8 lg:grid-cols-[2fr_1fr]">
            <div class="space-y-5">
                {{ form_row(form.title) }}
                {{ form_row(form.excerpt) }}
                {{ form_row(form.content) }}

                <button type="submit" class="rounded bg-ink px-4 py-2 text-white hover:bg-accent">
                    {{ article ? 'Save' : 'Create' }}
                </button>
            </div>

            <aside>
                <div class="rounded border border-rule p-4">
                    <h2 class="text-sm font-semibold">Filing</h2>
                    <div class="mt-3 space-y-4 text-sm">
                        {{ form_row(form.category) }}
                        {{ form_row(form.tags) }}
                        {{ form_row(form.featuredImage) }}
                    </div>
                </div>
            </aside>
        </div>
    {{ form_end(form) }}

    {% if article %}
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {#
               Hiding a control the viewer may not use is a courtesy. The
               permission is the check in the controller, which asks the same
               voter — and the tests submit these addresses directly rather than
               looking for an absent button.
            #}
            {% if is_granted('ARTICLE_PUBLISH', article) %}
                <div class="rounded border border-rule p-4">
                    <h2 class="text-sm font-semibold">Publication</h2>

                    <div class="mt-3 flex flex-wrap gap-2">
                        {% for transition in article.status.allowedTransitions %}
                            {% set act = {
                                'published': 'publish',
                                'draft': article.status.value == 'archived' ? 'restore' : 'unpublish',
                                'archived': 'archive',
                            }[transition.value] %}

                            <form method="post"
                                  action="{{ path('admin_article_transition', { id: article.id, transition: act }) }}">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('article-transition-' ~ article.id) }}">
                                <button type="submit"
                                        class="rounded border border-rule px-3 py-1.5 text-sm hover:border-accent hover:text-accent">
                                    {{ act|capitalize }}
                                </button>
                            </form>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if is_granted('ARTICLE_DELETE', article) %}
                <div class="rounded border border-red-200 p-4">
                    <h2 class="text-sm font-semibold text-red-800">Delete</h2>
                    <p class="mt-1 text-xs text-muted">This cannot be undone.</p>

                    <form method="post"
                          action="{{ path('admin_article_delete', { id: article.id }) }}"
                          class="mt-3"
                          data-confirm="Delete this article? It cannot be undone.">
                        <input type="hidden" name="_token" value="{{ csrf_token('article-delete-' ~ article.id) }}">
                        <button type="submit"
                                class="rounded border border-red-300 px-3 py-1.5 text-sm text-red-800 hover:bg-red-50">
                            Delete this article
                        </button>
                    </form>
                </div>
            {% endif %}
        </div>

        <p class="mt-6 text-xs text-muted">
            Address: <code>/articles/{{ article.slug }}</code> —
            {% if article.publishedAt %}
                frozen, because it has been published and people may have linked to it.
            {% else %}
                follows the title until this is published.
            {% endif %}
        </p>
    {% endif %}
{% endblock %}
