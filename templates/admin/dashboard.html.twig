{% extends 'admin/layout.html.twig' %}

{% block main %}
    <h1 class="text-2xl font-semibold tracking-tight">Administration</h1>

    <p class="mt-2 text-muted">
        Signed in as {{ app.user.displayName }}.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <a href="{{ path('admin_article_index') }}"
           class="rounded border border-rule p-5 no-underline hover:border-accent">
            <span class="block font-semibold text-ink">Articles</span>
            <span class="mt-1 block text-sm text-muted">Write, edit and publish.</span>
        </a>

        {% if is_granted('PAGE_EDIT', page_probe()) %}
            <a href="{{ path('admin_page_index') }}"
               class="rounded border border-rule p-5 no-underline hover:border-accent">
                <span class="block font-semibold text-ink">Pages</span>
                <span class="mt-1 block text-sm text-muted">Standalone pages and the site menu.</span>
            </a>
        {% endif %}

        {% if is_granted('MANAGE_MEDIA') %}
            <a href="{{ path('admin_media_index') }}"
               class="rounded border border-rule p-5 no-underline hover:border-accent">
                <span class="block font-semibold text-ink">Files</span>
                <span class="mt-1 block text-sm text-muted">Upload images and documents.</span>
            </a>
        {% endif %}
        {% if is_granted('MANAGE_TAXONOMY') %}
            <a href="{{ path('admin_manage') }}"
               class="rounded border border-rule p-5 no-underline hover:border-accent">
                <span class="block font-semibold text-ink">Manage</span>
                <span class="mt-1 block text-sm text-muted">
                    Sections, labels{% if is_granted('MANAGE_ACCOUNTS') %} and accounts{% endif %}.
                </span>
            </a>
        {% endif %}
    </div>
{% endblock %}
