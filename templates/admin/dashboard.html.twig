{% extends 'public/layout.html.twig' %}

{#
   A placeholder for the administration area feature 004 will build. It extends
   the public layout for now because there is no administration layout yet, and
   inventing one here would be guessing at what that feature needs.
#}

{% block title %}Administration — {{ site_name }}{% endblock %}

{% block main %}
    <h1 class="text-2xl font-semibold tracking-tight">Administration</h1>

    <p class="mt-3 text-muted">
        Signed in as {{ app.user.displayName }} ({{ app.user.email }}).
    </p>

    <p class="mt-2 text-sm text-muted">
        There is nothing here yet. Feature 003 fitted the lock; the screens it
        protects arrive with feature 004.
    </p>

    <form method="post" action="{{ path('logout') }}" class="mt-8">
        <button type="submit" class="text-sm text-accent hover:underline">Sign out</button>
    </form>
{% endblock %}
